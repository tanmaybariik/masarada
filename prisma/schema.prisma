generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  phone         String?
  role          String    @default("USER") // SUPER_ADMIN, ADMIN, USER, etc.
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  tickets       Ticket[]
  orders        Order[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Event {
  id               String   @id @default(cuid())
  slug             String?  @unique // Optional to avoid migration errors
  title            String
  titleEn          String   @default("")
  description      String?
  date             String
  time             String   @default("")
  location         String?
  price            Float    @default(0)
  availableTickets Int      @default(0)
  capacity         Int      @default(0)
  image            String   @default("")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  tickets          Ticket[]
}

model Ticket {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  status    String   @default("PENDING") // PENDING, CONFIRMED, USED, CANCELLED
  qrCode    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Order {
  id             String   @id @default(cuid())
  userId         String?
  date           String
  subtotal       Float
  discount       Float
  couponDiscount Float    @default(0)
  shipping       Float    @default(0)
  total          Float
  paymentMethod  String
  status         String   @default("PENDING") // processing, shipped, delivered, etc.
  statusText     String   @default("")
  trackingNumber String   @default("")
  
  // Customer details
  customerName    String
  customerPhone   String
  customerAddress String
  customerCity    String
  customerPincode String
  customerEmail   String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  user           User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items          OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Product {
  id            String   @id @default(cuid())
  name          String
  nameEn        String
  originalPrice Float
  price         Float
  category      String
  categoryName  String
  image         String
  inStock       Boolean  @default(true)
  rating        Float    @default(5.0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  orderItems    OrderItem[]
}

model Video {
  id          String   @id // Use YouTube ID
  title       String
  speaker     String
  duration    String
  views       Int      @default(0)
  isLive      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model StaffMember {
  id         String   @id @default(cuid())
  name       String
  phone      String
  email      String
  role       String
  status     String
  joinedDate String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model GalleryPhoto {
  id           String   @id @default(cuid())
  name         String
  enName       String
  category     String
  categoryName String
  url          String
  quality      String?
  dateAdded    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model LibraryArticle {
  id               String   @id @default(cuid()) // Can be custom slug
  titleBn          String
  titleEn          String
  subtitleBn       String
  subtitleEn       String
  authorBn         String
  authorEn         String
  category         String
  categoryBn       String
  categoryEn       String
  readTimeBn       String
  readTimeEn       String
  image            String
  featured         Boolean  @default(false)
  highlightQuoteBn String
  highlightQuoteEn String
  wikiSource       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  sections         ArticleSection[]
}

model ArticleSection {
  id               String   @id @default(cuid())
  articleId        String
  headingBn        String
  headingEn        String
  textBn           String   @db.Text
  textEn           String   @db.Text
  
  article          LibraryArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
}

model HeroSlide {
  id        String   @id @default(cuid())
  image     String   @db.Text
  position  String   @default("object-top")
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
